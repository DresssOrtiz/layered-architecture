# Copia este archivo a .env y ajusta los valores antes de `docker compose up`.
# Sin .env, docker-compose.yml usa exactamente estos mismos valores por defecto.

# --- MariaDB ---
DB_ROOT_PASSWORD=root
DB_NAME=layered_db
DB_USER=layered_user
DB_PASSWORD=layered_password
DB_PORT=3306

# --- Puertos publicados en el host ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Backend ---
# Origen permitido por CORS. El frontend habla con el backend a través de su propio
# endpoint /api/graphql, así que esto solo importa si consumes /graphql directamente.
CORS_ORIGIN=http://localhost:5173

# Rate limiting de la mutación inscribirEstudiante: intentos por ventana y ventana en ms.
RATE_LIMIT_INSCRIPCION=5
RATE_LIMIT_TTL=60000
